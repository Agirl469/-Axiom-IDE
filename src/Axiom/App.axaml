<Application
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Axiom.App">

	<Application.Resources>

		<SolidColorBrush
            x:Key="AxiomBackground"
            Color="#18181B" />

		<SolidColorBrush
            x:Key="AxiomPanel"
            Color="#202024" />

		<SolidColorBrush
            x:Key="AxiomBorder"
            Color="#303036" />

		<SolidColorBrush
            x:Key="AxiomForeground"
            Color="#E8E8EA" />

		<SolidColorBrush
            x:Key="AxiomMuted"
            Color="#92929A" />

		<SolidColorBrush
            x:Key="AxiomAccent"
            Color="#8B5CF6" />

		<SolidColorBrush
            x:Key="EditorBackground"
            Color="#121214" />

		<SolidColorBrush
            x:Key="EditorForeground"
            Color="#E8E8EA" />

		<SolidColorBrush
            x:Key="EditorSelection"
            Color="#35313D" />

	</Application.Resources>

	<Application.Styles>

		<FluentTheme />
		<Style Selector="Window">
			<Setter
				Property="Background"
				Value="{DynamicResource AxiomBackground}" />

			<Setter
				Property="Foreground"
				Value="{DynamicResource AxiomForeground}" />

			<Setter
				Property="FontFamily"
				Value="{DynamicResource AxiomUiFont}" />

			<Setter
				Property="FontSize"
				Value="{DynamicResource AxiomUiFontSize}" />
		</Style>

		<Style Selector="Button">
			<Setter
                Property="CornerRadius"
                Value="4" />

			<Setter
                Property="Padding"
                Value="12,7" />
		</Style>

		<Style Selector="Border.panel">
			<Setter
				Property="Background"
				Value="{DynamicResource AxiomPanel}" />

			<Setter
				Property="BorderBrush"
				Value="{DynamicResource AxiomBorder}" />
		</Style>

		<Style Selector="Border.panel">
			<Setter
                Property="Background"
                Value="{DynamicResource AxiomPanel}" />

			<Setter
                Property="BorderBrush"
                Value="{DynamicResource AxiomBorder}" />

			<Setter
                Property="BorderThickness"
                Value="1" />

			<Setter
                Property="CornerRadius"
                Value="5" />
		</Style>

		<Style Selector="TextBlock.muted">
			<Setter
                Property="Foreground"
                Value="{DynamicResource AxiomMuted}" />
		</Style>

	</Application.Styles>

</Application>