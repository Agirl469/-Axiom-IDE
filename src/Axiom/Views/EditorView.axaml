<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Axiom.Views.EditorView">
  <Grid RowDefinitions="Auto,*,190" ColumnDefinitions="260,*">
    <Border Grid.Row="0" Grid.ColumnSpan="2" Background="#1D1D20" BorderBrush="#303036" BorderThickness="0,0,0,1" Padding="8,6">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="Build" Click="Build_Click" />
			<Button Content="Run"
		  Click="Run_Click" />
        </StackPanel>
        <TextBlock x:Name="ProjectKindText" Grid.Column="1" VerticalAlignment="Center" Classes="muted" />
      </Grid>
    </Border>

	  <Border Grid.Row="1"
		  Grid.Column="0"
	  Background="{DynamicResource AxiomPanel}"
BorderBrush="{DynamicResource AxiomBorder}"
		  BorderThickness="0,0,1,0">

		  <Grid RowDefinitions="Auto,Auto,*">

			  <TextBlock
				  Text="PROJECT"
				  FontSize="12"
				  FontWeight="SemiBold"
				  Margin="12,10,12,6" />

			  <StackPanel
				  Grid.Row="1"
				  Orientation="Horizontal"
				  Spacing="5"
				  Margin="8,0,8,8">

				  <Button
					  Content="+ File"
					  Click="NewFile_Click" />

				  <Button
					  Content="+ Folder"
					  Click="NewFolder_Click" />

				  <Button
					  Content="↻"
					  ToolTip.Tip="Refresh"
					  Click="RefreshTree_Click" />

			  </StackPanel>

			  <TreeView
				  x:Name="ProjectTree"
				  Grid.Row="2"
				  DoubleTapped="ProjectTree_DoubleTapped">

				  <TreeView.ContextMenu>
					  <ContextMenu>

						  <MenuItem
							  Header="New File"
							  Click="NewFile_Click" />

						  <MenuItem
							  Header="New Folder"
							  Click="NewFolder_Click" />

						  <Separator />

						  <MenuItem
							  Header="Rename"
							  Click="RenameItem_Click" />

						  <MenuItem
							  Header="Delete"
							  Click="DeleteItem_Click" />

						  <Separator />

						  <MenuItem
							  Header="Refresh"
							  Click="RefreshTree_Click" />

					  </ContextMenu>
				  </TreeView.ContextMenu>

			  </TreeView>

		  </Grid>

	  </Border>

	  <Grid Grid.Row="1"
		  Grid.Column="1"
		  RowDefinitions="Auto,*">

		  <Border Background="{DynamicResource AxiomPanel}"
        BorderBrush="{DynamicResource AxiomBorder}"
				  BorderThickness="0,0,0,1">

			  <ScrollViewer
				  HorizontalScrollBarVisibility="Auto"
				  VerticalScrollBarVisibility="Disabled">

				  <StackPanel
					  x:Name="TabBar"
					  Orientation="Horizontal"
					  Spacing="2"
					  Margin="4,3" />

			  </ScrollViewer>

		  </Border>

		  <TextBox
			  x:Name="EditorBox"
			  Grid.Row="1"
			  AcceptsReturn="True"
			  AcceptsTab="True"
			  TextWrapping="NoWrap"
			  FontFamily="Cascadia Mono, JetBrains Mono, DejaVu Sans Mono, monospace"
			  FontSize="14"
			  Padding="14"
			  BorderThickness="0"
			  TextChanged="EditorBox_TextChanged"
			  KeyDown="EditorBox_KeyDown"
			  ScrollViewer.HorizontalScrollBarVisibility="Auto"
			  ScrollViewer.VerticalScrollBarVisibility="Auto" 
			  Background="{DynamicResource EditorBackground}"
		      Foreground="{DynamicResource EditorForeground}"
				SelectionBrush="{DynamicResource EditorSelection}"/>

	  </Grid>

	  <Border
	  Grid.Row="2"
	  Grid.ColumnSpan="2"
	  BorderBrush="{DynamicResource AxiomBorder}"
	  BorderThickness="0,1,0,0"
	  Background="{DynamicResource AxiomBackground}">
      <Grid RowDefinitions="Auto,*">
        <StackPanel Orientation="Horizontal" Spacing="18" Margin="12,7">
          <TextBlock Text="Output" FontWeight="SemiBold" />
          <TextBlock Text="Problems" Classes="muted" />
          <TextBlock Text="Terminal" Classes="muted" />
        </StackPanel>
        <TextBox x:Name="OutputBox"
                 Grid.Row="1"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 TextWrapping="NoWrap"
                 FontFamily="Cascadia Mono, JetBrains Mono, DejaVu Sans Mono, monospace"
                 FontSize="12"
                 BorderThickness="0"
                 Padding="12"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 ScrollViewer.VerticalScrollBarVisibility="Auto" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
