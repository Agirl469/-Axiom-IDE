<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Axiom.Views.EditorView">

	<Grid
        RowDefinitions="Auto,*,220"
        ColumnDefinitions="240,*"
        Background="{DynamicResource AxiomBackground}">


		<!-- TOP BAR -->
		<Border
            Grid.Row="0"
            Grid.ColumnSpan="2"
            Background="{DynamicResource AxiomPanel}"
            BorderBrush="{DynamicResource AxiomBorder}"
            BorderThickness="0,0,0,1">

			<Grid
                ColumnDefinitions="*,Auto"
                Margin="10,6">

				<TextBlock
                    Text="Axiom"
                    FontSize="13"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center" />
				<StackPanel
					Grid.Column="1"
					Orientation="Horizontal"
					Spacing="4">

					<Button
						Classes="ghost"
						Content="Build"
						ToolTip.Tip="Build project"
						Click="Build_Click" />

					<Button
						Classes="primary"
						Content="▶ Run"
						ToolTip.Tip="Run project"
						Click="Run_Click" />

					<Button
						Classes="ghost danger"
						Content="■"
						Width="32"
						Padding="0"
						ToolTip.Tip="Stop"
						Click="Stop_Click" />

				</StackPanel>

			</Grid>

		</Border>


		<!-- PROJECT EXPLORER -->
		<Border
            Grid.Row="1"
            Grid.Column="0"
            Background="{DynamicResource AxiomPanel}"
            BorderBrush="{DynamicResource AxiomBorder}"
            BorderThickness="0,0,1,0">

			<Grid RowDefinitions="Auto,*">

				<!-- Explorer header -->
				<Grid
                    Grid.Row="0"
                    ColumnDefinitions="*,Auto,Auto,Auto"
                    Margin="10,7">

					<TextBlock
                        Text="PROJECT"
                        FontSize="11"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center"
                        Classes="muted" />

					<Button
                        Grid.Column="1"
                        Content="+"
                        Width="30"
                        Height="28"
                        Padding="0"
                        ToolTip.Tip="New file"
                        Click="NewFile_Click" />

					<Button
                        Grid.Column="2"
                        Content="▾"
                        Width="30"
                        Height="28"
                        Padding="0"
                        Margin="3,0,0,0"
                        ToolTip.Tip="New folder"
                        Click="NewFolder_Click" />

					<Button
                        Grid.Column="3"
                        Content="↻"
                        Width="30"
                        Height="28"
                        Padding="0"
                        Margin="3,0,0,0"
                        ToolTip.Tip="Refresh project"
                        Click="RefreshTree_Click" />

				</Grid>


				<!-- Project files -->
				<TreeView
                    x:Name="ProjectTree"
                    Grid.Row="1"
                    Margin="4,0,4,4"
                    BorderThickness="0"
                    DoubleTapped="ProjectTree_DoubleTapped">

					<TreeView.ContextMenu>

						<ContextMenu>

							<MenuItem
                                Header="New File"
                                Click="NewFile_Click" />

							<MenuItem
                                Header="New Folder"
                                Click="NewFolder_Click" />

							<Separator />

							<MenuItem
                                Header="Rename"
                                Click="RenameItem_Click" />

							<MenuItem
                                Header="Delete"
                                Click="DeleteItem_Click" />

							<Separator />

							<MenuItem
                                Header="Refresh"
                                Click="RefreshTree_Click" />

						</ContextMenu>

					</TreeView.ContextMenu>

				</TreeView>

			</Grid>

		</Border>


		<!-- EDITOR -->
		<Grid
            Grid.Row="1"
            Grid.Column="1"
            RowDefinitions="Auto,Auto,*">


			<!-- TABS -->
			<Border
                Grid.Row="0"
                Background="{DynamicResource AxiomPanel}"
                BorderBrush="{DynamicResource AxiomBorder}"
                BorderThickness="0,0,0,1">

				<ScrollViewer
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Disabled">

					<StackPanel
                        x:Name="TabBar"
                        Orientation="Horizontal"
                        Spacing="2"
                        Margin="4,3" />

				</ScrollViewer>

			</Border>


			<!-- FIND BAR -->
			<Border
                x:Name="FindBar"
                Grid.Row="1"
                IsVisible="False"
                Background="{DynamicResource AxiomPanel}"
                BorderBrush="{DynamicResource AxiomBorder}"
                BorderThickness="0,0,0,1"
                Padding="8,6">

				<Grid
                    ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto">

					<TextBox
                        x:Name="FindBox"
                        MinWidth="220"
                        PlaceholderText="Find in current file"
                        KeyDown="FindBox_KeyDown"
                        TextChanged="FindBox_TextChanged" />

					<TextBlock
                        x:Name="FindCountText"
                        Grid.Column="1"
                        MinWidth="70"
                        Margin="10,0"
                        VerticalAlignment="Center"
                        TextAlignment="Center"
                        Classes="muted"
                        Text="0 results" />

					<ToggleButton
                        x:Name="FindCaseButton"
                        Grid.Column="2"
                        Content="Aa"
                        Padding="8,5"
                        ToolTip.Tip="Match case"
                        Click="FindOption_Click" />

					<ToggleButton
                        x:Name="FindWordButton"
                        Grid.Column="3"
                        Content="Word"
                        Padding="8,5"
                        Margin="4,0,0,0"
                        ToolTip.Tip="Match whole word"
                        Click="FindOption_Click" />

					<Button
                        Grid.Column="4"
                        Content="↑"
                        Width="34"
                        Padding="0"
                        Margin="8,0,0,0"
                        ToolTip.Tip="Previous match"
                        Click="FindPrevious_Click" />

					<Button
                        Grid.Column="5"
                        Content="↓"
                        Width="34"
                        Padding="0"
                        Margin="4,0,0,0"
                        ToolTip.Tip="Next match"
                        Click="FindNext_Click" />

				</Grid>

			</Border>


			<!-- CODE EDITOR -->
			<TextBox
                x:Name="EditorBox"
                Grid.Row="2"
                AcceptsReturn="True"
                AcceptsTab="True"
                TextWrapping="NoWrap"
                FontFamily="{DynamicResource AxiomEditorFont}"
                FontSize="{DynamicResource AxiomEditorFontSize}"
                Padding="14"
                BorderThickness="0"
                Background="{DynamicResource EditorBackground}"
                Foreground="{DynamicResource EditorForeground}"
                SelectionBrush="{DynamicResource SearchHighlight}"
                SelectionForegroundBrush="White"
                TextChanged="EditorBox_TextChanged"
                KeyDown="EditorBox_KeyDown"
                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                ScrollViewer.VerticalScrollBarVisibility="Auto" />

		</Grid>


		<!-- BOTTOM PANEL -->
		<Border
            Grid.Row="2"
            Grid.ColumnSpan="2"
            Background="{DynamicResource AxiomBackground}"
            BorderBrush="{DynamicResource AxiomBorder}"
            BorderThickness="0,1,0,0">

			<Grid RowDefinitions="Auto,*">


				<!-- BOTTOM PANEL TABS -->
				<Border
                    Grid.Row="0"
                    Background="{DynamicResource AxiomPanel}"
                    BorderBrush="{DynamicResource AxiomBorder}"
                    BorderThickness="0,0,0,1">

					<StackPanel
                        Orientation="Horizontal"
                        Spacing="2"
                        Margin="6,3">

						<Button
                            x:Name="OutputTabButton"
							Classes="bottomTab"
                            Content="Output"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="10,5"
                            Click="OutputTab_Click" />

						<Button
                            x:Name="ProblemsTabButton"
							Classes="bottomTab"
                            Content="Problems"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="10,5"
                            Click="ProblemsTab_Click" />

						<Button
                            x:Name="TerminalTabButton"
							Classes="bottomTab"
                            Content="Terminal"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="10,5"
                            Click="TerminalTab_Click" />

						<Button
                            x:Name="SearchTabButton"
							Classes="bottomTab"
                            Content="Search"
                            
                            Padding="10,5"
                            Click="SearchTab_Click" />

					</StackPanel>

				</Border>


				<!-- OUTPUT -->
				<TextBox
                    x:Name="OutputBox"
                    Grid.Row="1"
                    IsReadOnly="True"
                    AcceptsReturn="True"
                    TextWrapping="NoWrap"
                    FontFamily="{DynamicResource AxiomEditorFont}"
                    FontSize="{DynamicResource AxiomEditorFontSize}"
                    BorderThickness="0"
                    Padding="12"
                    Background="{DynamicResource EditorBackground}"
                    Foreground="{DynamicResource EditorForeground}"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                    ScrollViewer.VerticalScrollBarVisibility="Auto" />


				<!-- PROBLEMS -->
				<ListBox
                    x:Name="ProblemsList"
					Classes="bottomTab"
                    Grid.Row="1"
                    IsVisible="False"
                    BorderThickness="0"
                    Background="{DynamicResource EditorBackground}"
                    DoubleTapped="ProblemsList_DoubleTapped">

					<ListBox.ItemTemplate>

						<DataTemplate x:CompileBindings="False">

							<Border
                                BorderBrush="{DynamicResource AxiomBorder}"
                                BorderThickness="0,0,0,1"
                                Padding="10,7">

								<Grid
                                    ColumnDefinitions="90,180,80,*">

									<TextBlock
                                        Grid.Column="0"
                                        Text="{Binding Severity}"
                                        FontWeight="SemiBold" />

									<TextBlock
                                        Grid.Column="1"
                                        Text="{Binding DisplayFile}" />

									<TextBlock
                                        Grid.Column="2"
                                        Text="{Binding DisplayLocation}"
                                        Classes="muted" />

									<TextBlock
                                        Grid.Column="3"
                                        Text="{Binding Message}"
                                        TextWrapping="Wrap" />

								</Grid>

							</Border>

						</DataTemplate>

					</ListBox.ItemTemplate>

				</ListBox>


				<!-- TERMINAL -->
				<Grid
                    x:Name="TerminalPanel"
                    Grid.Row="1"
                    IsVisible="False"
                    RowDefinitions="*,Auto"
                    Background="{DynamicResource EditorBackground}">

					<TextBox
                        x:Name="TerminalOutput"
                        Grid.Row="0"
                        IsReadOnly="True"
                        AcceptsReturn="True"
                        TextWrapping="NoWrap"
                        FontFamily="{DynamicResource AxiomEditorFont}"
                        FontSize="{DynamicResource AxiomEditorFontSize}"
                        Padding="10"
                        BorderThickness="0"
                        Background="{DynamicResource EditorBackground}"
                        Foreground="{DynamicResource EditorForeground}"
                        ScrollViewer.HorizontalScrollBarVisibility="Auto"
                        ScrollViewer.VerticalScrollBarVisibility="Auto" />


					<!-- terminal command line -->
					<Border
                        Grid.Row="1"
                        Background="{DynamicResource AxiomPanel}"
                        BorderBrush="{DynamicResource AxiomBorder}"
                        BorderThickness="0,1,0,0"
                        Padding="6">

						<Grid ColumnDefinitions="Auto,*">

							<TextBlock
                                Text="›"
                                Margin="5,0,8,0"
                                FontFamily="{DynamicResource AxiomEditorFont}"
                                FontSize="{DynamicResource AxiomEditorFontSize}"
                                VerticalAlignment="Center"
                                Classes="muted" />

							<TextBox
                                x:Name="TerminalInput"
                                Grid.Column="1"
                                PlaceholderText="Enter command..."
                                FontFamily="{DynamicResource AxiomEditorFont}"
                                FontSize="{DynamicResource AxiomEditorFontSize}"
                                BorderThickness="0"
                                Padding="6"
                                KeyDown="TerminalInput_KeyDown" />

						</Grid>

					</Border>

				</Grid>


				<!-- PROJECT SEARCH -->
				<Grid
                    x:Name="ProjectSearchPanel"
                    Grid.Row="1"
                    IsVisible="False"
                    RowDefinitions="Auto,*"
                    Background="{DynamicResource EditorBackground}">

					<Border
                        Grid.Row="0"
                        Background="{DynamicResource AxiomPanel}"
                        BorderBrush="{DynamicResource AxiomBorder}"
                        BorderThickness="0,0,0,1"
                        Padding="8">

						<Grid ColumnDefinitions="*,Auto">

							<TextBox
                                x:Name="ProjectSearchBox"
                                PlaceholderText="Search the entire project"
                                KeyDown="ProjectSearchBox_KeyDown" />

							<Button
                                Grid.Column="1"
                                Content="Search"
                                Padding="12,6"
                                Margin="6,0,0,0"
                                Click="ProjectSearch_Click" />

						</Grid>

					</Border>

					<ListBox
                        x:Name="ProjectSearchResults"
                        Grid.Row="1"
                        BorderThickness="0"
                        Background="{DynamicResource EditorBackground}"
                        DoubleTapped="ProjectSearchResults_DoubleTapped" />

				</Grid>

			</Grid>

		</Border>

	</Grid>

</UserControl>