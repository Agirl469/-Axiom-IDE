<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Axiom.Views.EditorView">
  <Grid RowDefinitions="Auto,*,190" ColumnDefinitions="260,*">
    <Border Grid.Row="0" Grid.ColumnSpan="2" Background="#1D1D20" BorderBrush="#303036" BorderThickness="0,0,0,1" Padding="8,6">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="Build" Click="Build_Click" />
			<Button Content="Run"
		  Click="Run_Click" />
        </StackPanel>
        <TextBlock x:Name="ProjectKindText" Grid.Column="1" VerticalAlignment="Center" Classes="muted" />
      </Grid>
    </Border>

    <Border Grid.Row="1" Grid.Column="0" Background="#1B1B1E" BorderBrush="#303036" BorderThickness="0,0,1,0">
      <Grid RowDefinitions="Auto,*">
        <TextBlock Text="PROJECT" FontSize="12" FontWeight="SemiBold" Margin="12,10,12,8" />
        <ListBox x:Name="FileList" Grid.Row="1" SelectionChanged="FileList_SelectionChanged" />
      </Grid>
    </Border>

    <Grid Grid.Row="1" Grid.Column="1" RowDefinitions="Auto,*">
      <Border Background="#202023" BorderBrush="#303036" BorderThickness="0,0,0,1" Padding="10,6">
        <TextBlock x:Name="CurrentFileText" Text="No file open" Classes="muted" />
      </Border>
      <TextBox x:Name="EditorBox"
               Grid.Row="1"
               AcceptsReturn="True"
               AcceptsTab="True"
               TextWrapping="NoWrap"
               FontFamily="Cascadia Mono, JetBrains Mono, DejaVu Sans Mono, monospace"
               FontSize="14"
               Padding="14"
               BorderThickness="0"
               ScrollViewer.HorizontalScrollBarVisibility="Auto"
                ScrollViewer.VerticalScrollBarVisibility="Auto" />
    </Grid>

    <Border Grid.Row="2" Grid.ColumnSpan="2" BorderBrush="#303036" BorderThickness="0,1,0,0" Background="#18181B">
      <Grid RowDefinitions="Auto,*">
        <StackPanel Orientation="Horizontal" Spacing="18" Margin="12,7">
          <TextBlock Text="Output" FontWeight="SemiBold" />
          <TextBlock Text="Problems" Classes="muted" />
          <TextBlock Text="Terminal" Classes="muted" />
        </StackPanel>
        <TextBox x:Name="OutputBox"
                 Grid.Row="1"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 TextWrapping="NoWrap"
                 FontFamily="Cascadia Mono, JetBrains Mono, DejaVu Sans Mono, monospace"
                 FontSize="12"
                 BorderThickness="0"
                 Padding="12"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 ScrollViewer.VerticalScrollBarVisibility="Auto" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
