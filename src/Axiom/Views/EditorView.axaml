<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:edit="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
    x:Class="Axiom.Views.EditorView">

	<Grid
        RowDefinitions="Auto,*,180"
        ColumnDefinitions="240,*"
        Background="{DynamicResource AxiomBackground}">

		<!-- TOP BAR -->
		<Border
            Grid.Row="0"
            Grid.ColumnSpan="2"
            Background="{DynamicResource AxiomPanel}"
            BorderBrush="{DynamicResource AxiomBorder}"
            BorderThickness="0,0,0,1">

			<Grid
                ColumnDefinitions="*,Auto"
                Margin="10,6">

				<StackPanel
                    Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Center">

					<TextBlock
                        Text="Axiom"
                        FontSize="13"
                        FontWeight="SemiBold" />

					<TextBlock
                        Text="•"
                        Classes="muted" />

					<TextBlock
                        x:Name="ProjectKindText"
                        Text="Project"
                        FontSize="12"
                        Classes="muted" />

				</StackPanel>

				<StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="4">

					<Button
                        Content="Build"
                        Click="Build_Click" />

					<Button
                        Content="▶ Run"
                        Click="Run_Click" />

					<Button
                        Content="■"
                        Width="34"
                        Padding="0"
                        Click="Stop_Click" />

				</StackPanel>

			</Grid>

		</Border>


		<!-- PROJECT -->
		<Border
            Grid.Row="1"
            Grid.Column="0"
            Background="{DynamicResource AxiomPanel}"
            BorderBrush="{DynamicResource AxiomBorder}"
            BorderThickness="0,0,1,0">

			<Grid RowDefinitions="Auto,*">

				<Grid
                    ColumnDefinitions="*,Auto,Auto,Auto"
                    Margin="10,7">

					<TextBlock
                        Text="PROJECT"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Classes="muted"
                        VerticalAlignment="Center" />

					<Button
                        Grid.Column="1"
                        Content="+"
                        Width="30"
                        Padding="0"
                        ToolTip.Tip="New file"
                        Click="NewFile_Click" />

					<Button
                        Grid.Column="2"
                        Content="▾"
                        Width="30"
                        Padding="0"
                        Margin="3,0,0,0"
                        ToolTip.Tip="New folder"
                        Click="NewFolder_Click" />

					<Button
                        Grid.Column="3"
                        Content="↻"
                        Width="30"
                        Padding="0"
                        Margin="3,0,0,0"
                        ToolTip.Tip="Refresh"
                        Click="RefreshTree_Click" />

				</Grid>

				<TreeView
                    x:Name="ProjectTree"
                    Grid.Row="1"
                    Margin="4"
                    BorderThickness="0"
                    DoubleTapped="ProjectTree_DoubleTapped">

					<TreeView.ContextMenu>
						<ContextMenu>

							<MenuItem
                                Header="New File"
                                Click="NewFile_Click" />

							<MenuItem
                                Header="New Folder"
                                Click="NewFolder_Click" />

							<Separator />

							<MenuItem
                                Header="Rename"
                                Click="RenameItem_Click" />

							<MenuItem
                                Header="Delete"
                                Click="DeleteItem_Click" />

							<Separator />

							<MenuItem
                                Header="Refresh"
                                Click="RefreshTree_Click" />

						</ContextMenu>
					</TreeView.ContextMenu>

				</TreeView>

			</Grid>

		</Border>


		<!-- EDITOR -->
		<Grid
            Grid.Row="1"
            Grid.Column="1"
            RowDefinitions="Auto,Auto,*">

			<!-- TABS -->
			<Border
                Grid.Row="0"
                Background="{DynamicResource AxiomPanel}"
                BorderBrush="{DynamicResource AxiomBorder}"
                BorderThickness="0,0,0,1">

				<ScrollViewer
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Disabled">

					<StackPanel
                        x:Name="TabBar"
                        Orientation="Horizontal"
                        Spacing="2"
                        Margin="4,3" />

				</ScrollViewer>

			</Border>


			<!-- FIND -->
			<Border
                x:Name="FindBar"
                Grid.Row="1"
                IsVisible="False"
                Padding="8,6"
                Background="{DynamicResource AxiomPanel}"
                BorderBrush="{DynamicResource AxiomBorder}"
                BorderThickness="0,0,0,1">

				<Grid
                    ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto">

					<TextBox
                        x:Name="FindBox"
                        PlaceholderText="Find in current file"
                        TextChanged="FindBox_TextChanged"
                        KeyDown="FindBox_KeyDown" />

					<TextBlock
                        x:Name="FindCountText"
                        Grid.Column="1"
                        Text="0 results"
                        Margin="10,0"
                        VerticalAlignment="Center"
                        Classes="muted" />

					<ToggleButton
                        x:Name="FindCaseButton"
                        Grid.Column="2"
                        Content="Aa"
                        Click="FindOption_Click" />

					<ToggleButton
                        x:Name="FindWordButton"
                        Grid.Column="3"
                        Content="Word"
                        Margin="4,0,0,0"
                        Click="FindOption_Click" />

					<Button
                        Grid.Column="4"
                        Content="↑"
                        Width="34"
                        Margin="8,0,0,0"
                        Click="FindPrevious_Click" />

					<Button
                        Grid.Column="5"
                        Content="↓"
                        Width="34"
                        Margin="4,0,0,0"
                        Click="FindNext_Click" />

				</Grid>

			</Border>


			<!-- REAL CODE EDITOR -->
			<edit:TextEditor
                x:Name="EditorBox"
                Grid.Row="2"

                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"

                IsEnabled="True"
                IsReadOnly="False"
                Focusable="True"
                IsHitTestVisible="True"

                ShowLineNumbers="True"
                WordWrap="False"

                FontFamily="{DynamicResource AxiomEditorFont}"
                FontSize="{DynamicResource AxiomEditorFontSize}"

                Background="{DynamicResource EditorBackground}"
                Foreground="{DynamicResource EditorForeground}"

                Padding="8"

                HorizontalScrollBarVisibility="Auto"
                VerticalScrollBarVisibility="Auto"

                TextChanged="EditorBox_TextChanged"
                KeyDown="EditorBox_KeyDown" />

		</Grid>


		<!-- BOTTOM -->
		<Border
            Grid.Row="2"
            Grid.ColumnSpan="2"
            Background="{DynamicResource AxiomBackground}"
            BorderBrush="{DynamicResource AxiomBorder}"
            BorderThickness="0,1,0,0">

			<Grid RowDefinitions="Auto,*">

				<Border
                    Background="{DynamicResource AxiomPanel}"
                    BorderBrush="{DynamicResource AxiomBorder}"
                    BorderThickness="0,0,0,1">

					<StackPanel
                        Orientation="Horizontal"
                        Spacing="2"
                        Margin="6,3">

						<Button
                            x:Name="OutputTabButton"
                            Content="Output"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="OutputTab_Click" />

						<Button
                            x:Name="ProblemsTabButton"
                            Content="Problems"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="ProblemsTab_Click" />

						<Button
                            x:Name="TerminalTabButton"
                            Content="Terminal"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="TerminalTab_Click" />

						<Button
                            Content="Search"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="SearchTab_Click" />

					</StackPanel>

				</Border>


				<TextBox
                    x:Name="OutputBox"
                    Grid.Row="1"
                    IsReadOnly="True"
                    AcceptsReturn="True"
                    TextWrapping="NoWrap"
                    BorderThickness="0"
                    Padding="10"
                    FontFamily="{DynamicResource AxiomEditorFont}"
                    FontSize="{DynamicResource AxiomEditorFontSize}"
                    Background="{DynamicResource EditorBackground}"
                    Foreground="{DynamicResource EditorForeground}"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                    ScrollViewer.VerticalScrollBarVisibility="Auto" />


				<ListBox
                    x:Name="ProblemsList"
                    Grid.Row="1"
                    IsVisible="False"
                    BorderThickness="0"
                    Background="{DynamicResource EditorBackground}"
                    DoubleTapped="ProblemsList_DoubleTapped">

					<ListBox.ItemTemplate>
						<DataTemplate x:CompileBindings="False">

							<Grid
                                ColumnDefinitions="90,180,80,*"
                                Margin="8,5">

								<TextBlock
                                    Text="{Binding Severity}" />

								<TextBlock
                                    Grid.Column="1"
                                    Text="{Binding DisplayFile}" />

								<TextBlock
                                    Grid.Column="2"
                                    Text="{Binding DisplayLocation}"
                                    Classes="muted" />

								<TextBlock
                                    Grid.Column="3"
                                    Text="{Binding Message}"
                                    TextWrapping="Wrap" />

							</Grid>

						</DataTemplate>
					</ListBox.ItemTemplate>

				</ListBox>


				<Grid
                    x:Name="TerminalPanel"
                    Grid.Row="1"
                    IsVisible="False"
                    RowDefinitions="*,Auto"
                    Background="{DynamicResource EditorBackground}">

					<TextBox
                        x:Name="TerminalOutput"
                        IsReadOnly="True"
                        AcceptsReturn="True"
                        TextWrapping="NoWrap"
                        BorderThickness="0"
                        Padding="10"
                        FontFamily="{DynamicResource AxiomEditorFont}"
                        FontSize="{DynamicResource AxiomEditorFontSize}"
                        Background="{DynamicResource EditorBackground}"
                        Foreground="{DynamicResource EditorForeground}" />

					<Border
                        Grid.Row="1"
                        BorderBrush="{DynamicResource AxiomBorder}"
                        BorderThickness="0,1,0,0"
                        Padding="6">

						<Grid ColumnDefinitions="Auto,*">

							<TextBlock
                                Text="›"
                                Margin="5,0,8,0"
                                VerticalAlignment="Center"
                                Classes="muted" />

							<TextBox
                                x:Name="TerminalInput"
                                Grid.Column="1"
                                PlaceholderText="Enter command..."
                                BorderThickness="0"
                                KeyDown="TerminalInput_KeyDown" />

						</Grid>

					</Border>

				</Grid>


				<Grid
                    x:Name="ProjectSearchPanel"
                    Grid.Row="1"
                    IsVisible="False"
                    RowDefinitions="Auto,*">

					<Grid
                        ColumnDefinitions="*,Auto"
                        Margin="8">

						<TextBox
                            x:Name="ProjectSearchBox"
                            PlaceholderText="Search project"
                            KeyDown="ProjectSearchBox_KeyDown" />

						<Button
                            Grid.Column="1"
                            Content="Search"
                            Margin="6,0,0,0"
                            Click="ProjectSearch_Click" />

					</Grid>

					<ListBox
                        x:Name="ProjectSearchResults"
                        Grid.Row="1"
                        DoubleTapped="ProjectSearchResults_DoubleTapped" />

				</Grid>

			</Grid>

		</Border>

	</Grid>

</UserControl>