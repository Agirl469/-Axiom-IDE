<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Axiom.Views.NewProjectWindow"
        Title="Create a new project"
        Width="760"
        Height="520"
        CanResize="False"
        WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="Auto,*,Auto" Margin="24">
    <StackPanel Spacing="4">
      <TextBlock Text="Create a new project" FontSize="26" FontWeight="SemiBold" />
      <TextBlock Text="The first templates stay simple so the generated project is easy to understand." Classes="muted" />
    </StackPanel>

    <Grid Grid.Row="1" ColumnDefinitions="260,*" Margin="0,22,0,18">
      <ListBox x:Name="TemplateList" SelectionChanged="TemplateList_SelectionChanged">
        <ListBoxItem Content="C++ · CMake console" Tag="cpp" />
        <ListBoxItem Content="C# · Console" Tag="csharp" />
        <ListBoxItem Content="Rust · Cargo binary" Tag="rust" />
        <ListBoxItem Content="Python · Basic project" Tag="python" />
      </ListBox>

      <StackPanel Grid.Column="1" Margin="20,0,0,0" Spacing="12">
        <TextBlock x:Name="TemplateTitle" Text="Choose a template" FontSize="18" FontWeight="SemiBold" />
        <TextBlock x:Name="TemplateDescription" Text="Select a project type on the left." Classes="muted" TextWrapping="Wrap" />
        <TextBlock Text="Project name" Margin="0,10,0,0" />
        <TextBox x:Name="ProjectNameBox" Text="MyProject" />
        <TextBlock Text="Location" />
        <Grid ColumnDefinitions="*,Auto">
          <TextBox x:Name="LocationBox" />
          <Button Grid.Column="1" Content="Browse..." Margin="8,0,0,0" Click="Browse_Click" />
        </Grid>
      </StackPanel>
    </Grid>

    <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto">
      <TextBlock x:Name="StatusText" VerticalAlignment="Center" Classes="muted" />
      <Button Grid.Column="1" Content="Cancel" Margin="0,0,8,0" Click="Cancel_Click" />
      <Button Grid.Column="2" Content="Create" Classes="primary" Click="Create_Click" />
    </Grid>
  </Grid>
</Window>
