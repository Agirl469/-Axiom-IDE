<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Axiom.Views.SettingsView">

	<Grid
        ColumnDefinitions="190,*"
        Background="{DynamicResource AxiomBackground}">


		<!-- SETTINGS SIDEBAR -->
		<Border
            Grid.Column="0"
            Background="{DynamicResource AxiomPanel}"
            BorderBrush="{DynamicResource AxiomBorder}"
            BorderThickness="0,0,1,0">

			<Grid
                RowDefinitions="Auto,*"
                Margin="12">

				<StackPanel
                    Margin="4,8,4,18"
                    Spacing="3">

					<TextBlock
                        Text="Settings"
                        FontSize="22"
                        FontWeight="SemiBold" />

					<TextBlock
                        Text="Customize Axiom"
                        Classes="muted"
                        FontSize="12" />

				</StackPanel>


				<ListBox
                    x:Name="CategoryList"
                    Grid.Row="1"
                    SelectionChanged="CategoryList_SelectionChanged">

					<ListBoxItem Tag="general">
						<TextBlock Text="General" />
					</ListBoxItem>

					<ListBoxItem Tag="appearance">
						<TextBlock Text="Appearance" />
					</ListBoxItem>

					<ListBoxItem Tag="editor">
						<TextBlock Text="Editor" />
					</ListBoxItem>

					<ListBoxItem Tag="keybinds">
						<TextBlock Text="Keybinds" />
					</ListBoxItem>

					<ListBoxItem Tag="effects">
						<TextBlock Text="Effects" />
					</ListBoxItem>

					<ListBoxItem Tag="plugins">
						<TextBlock Text="Plugins" />
					</ListBoxItem>

					<ListBoxItem Tag="toolchains">
						<TextBlock Text="Toolchains" />
					</ListBoxItem>

					<ListBoxItem Tag="privacy">
						<TextBlock Text="Privacy" />
					</ListBoxItem>

				</ListBox>

			</Grid>

		</Border>


		<!-- RIGHT SIDE -->
		<Grid
            Grid.Column="1"
            RowDefinitions="Auto,*">

			<Border
                Grid.Row="0"
                Padding="24,20,24,16"
                BorderBrush="{DynamicResource AxiomBorder}"
                BorderThickness="0,0,0,1">

				<StackPanel Spacing="3">

					<TextBlock
                        x:Name="PageTitle"
                        Text="General"
                        FontSize="23"
                        FontWeight="SemiBold" />

					<TextBlock
                        x:Name="PageDescription"
                        Text="General Axiom preferences."
                        Classes="muted" />

				</StackPanel>

			</Border>


			<ScrollViewer
                Grid.Row="1"
                VerticalScrollBarVisibility="Auto">

				<ContentControl
                    x:Name="SettingsHost"
                    Margin="24"
                    HorizontalContentAlignment="Stretch" />

			</ScrollViewer>

		</Grid>

	</Grid>

</UserControl>