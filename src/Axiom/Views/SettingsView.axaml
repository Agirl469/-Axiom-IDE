<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="clr-namespace:Axiom.Views"
    x:Class="Axiom.Views.SettingsView">

	<ScrollViewer
        VerticalScrollBarVisibility="Auto">

		<StackPanel
            Margin="24"
            Spacing="14">

			<TextBlock
                Text="Settings"
                FontSize="26"
                FontWeight="SemiBold" />

			<TextBlock
                Text="Configure the editor and shortcuts."
                Classes="muted" />

			<Border
                Classes="panel"
                Padding="18">

				<StackPanel Spacing="12">

					<TextBlock
                        Text="Editor"
                        FontSize="18"
                        FontWeight="SemiBold" />

					<Grid ColumnDefinitions="*,180">

						<TextBlock
                            Text="Font size"
                            VerticalAlignment="Center" />

						<NumericUpDown
                            Grid.Column="1"
                            Value="14"
                            Minimum="9"
                            Maximum="30" />

					</Grid>

					<Grid ColumnDefinitions="*,180">

						<TextBlock
                            Text="Tab width"
                            VerticalAlignment="Center" />

						<NumericUpDown
                            Grid.Column="1"
                            Value="4"
                            Minimum="2"
                            Maximum="8" />

					</Grid>

				</StackPanel>

			</Border>

			<Border
                Classes="panel"
                Padding="0">

				<views:KeybindsView />

			</Border>
			<Border
				Classes="panel"
				Padding="14">

				<views:EffectsSettingsView />

			</Border>
			
			<Border
                Classes="panel"
                Padding="18">

				<StackPanel Spacing="8">

					<TextBlock
                        Text="Privacy"
                        FontSize="18"
                        FontWeight="SemiBold" />

					<TextBlock
                        Text="Axiom has no telemetry, account system, cloud sync, or built-in AI service."
                        Classes="muted"
                        TextWrapping="Wrap" />

				</StackPanel>

			</Border>

		</StackPanel>

	</ScrollViewer>

</UserControl>