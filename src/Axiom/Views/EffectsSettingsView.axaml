<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Axiom.Views.EffectsSettingsView">

	<StackPanel
        Margin="4"
        Spacing="16">

		<Grid ColumnDefinitions="*,Auto">

			<StackPanel Spacing="3">

				<TextBlock
                    Text="Visual Effects"
                    FontSize="20"
                    FontWeight="SemiBold" />

				<TextBlock
                    Text="Particles, ambient effects and custom effect packages."
                    Classes="muted" />

			</StackPanel>

			<ToggleSwitch
                x:Name="EffectsEnabled"
                Grid.Column="1"
                IsCheckedChanged="SettingChanged" />

		</Grid>


		<Border
            Classes="panel"
            Padding="14">

			<StackPanel Spacing="12">

				<TextBlock
                    Text="Profile"
                    FontWeight="SemiBold" />

				<ComboBox
                    x:Name="ProfileBox"
                    SelectionChanged="ProfileChanged" />

				<TextBlock
                    Text="Profiles change several effect settings at once. Choose Custom to configure everything manually."
                    FontSize="12"
                    TextWrapping="Wrap"
                    Classes="muted" />

			</StackPanel>

		</Border>


		<Border
            Classes="panel"
            Padding="14">

			<StackPanel Spacing="10">

				<TextBlock
                    Text="Built-in Effects"
                    FontSize="17"
                    FontWeight="SemiBold" />

				<CheckBox
                    x:Name="PetalsEnabled"
                    Content="Petals"
                    IsCheckedChanged="SettingChanged" />

				<CheckBox
                    x:Name="LeavesEnabled"
                    Content="Leaves"
                    IsCheckedChanged="SettingChanged" />

				<CheckBox
                    x:Name="SnowEnabled"
                    Content="Snow"
                    IsCheckedChanged="SettingChanged" />

				<CheckBox
                    x:Name="RainEnabled"
                    Content="Rain"
                    IsCheckedChanged="SettingChanged" />

				<CheckBox
                    x:Name="FirefliesEnabled"
                    Content="Fireflies"
                    IsCheckedChanged="SettingChanged" />

				<CheckBox
                    x:Name="StarsEnabled"
                    Content="Stars"
                    IsCheckedChanged="SettingChanged" />

				<CheckBox
                    x:Name="NyanCatEnabled"
                    Content="Occasional Nyan Cat"
                    IsCheckedChanged="SettingChanged" />

			</StackPanel>

		</Border>


		<Border
            Classes="panel"
            Padding="14">

			<StackPanel Spacing="12">

				<TextBlock
                    Text="Particle Settings"
                    FontSize="17"
                    FontWeight="SemiBold" />

				<Grid ColumnDefinitions="120,*,65">

					<TextBlock
                        Text="Density"
                        VerticalAlignment="Center" />

					<Slider
                        x:Name="DensitySlider"
                        Grid.Column="1"
                        Minimum="1"
                        Maximum="20"
                        ValueChanged="SliderChanged" />

					<TextBlock
                        x:Name="DensityText"
                        Grid.Column="2"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center" />

				</Grid>


				<Grid ColumnDefinitions="120,*,65">

					<TextBlock
                        Text="Speed"
                        VerticalAlignment="Center" />

					<Slider
                        x:Name="SpeedSlider"
                        Grid.Column="1"
                        Minimum="0.2"
                        Maximum="3"
                        ValueChanged="SliderChanged" />

					<TextBlock
                        x:Name="SpeedText"
                        Grid.Column="2"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center" />

				</Grid>


				<Grid ColumnDefinitions="120,*,65">

					<TextBlock
                        Text="Opacity"
                        VerticalAlignment="Center" />

					<Slider
                        x:Name="OpacitySlider"
                        Grid.Column="1"
                        Minimum="0.1"
                        Maximum="1"
                        ValueChanged="SliderChanged" />

					<TextBlock
                        x:Name="OpacityText"
                        Grid.Column="2"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center" />

				</Grid>


				<Grid ColumnDefinitions="120,*,65">

					<TextBlock
                        Text="Size"
                        VerticalAlignment="Center" />

					<Slider
                        x:Name="SizeSlider"
                        Grid.Column="1"
                        Minimum="8"
                        Maximum="40"
                        ValueChanged="SliderChanged" />

					<TextBlock
                        x:Name="SizeText"
                        Grid.Column="2"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center" />

				</Grid>


				<Grid ColumnDefinitions="120,*,65">

					<TextBlock
                        Text="Wind"
                        VerticalAlignment="Center" />

					<Slider
                        x:Name="WindSlider"
                        Grid.Column="1"
                        Minimum="-2"
                        Maximum="2"
                        ValueChanged="SliderChanged" />

					<TextBlock
                        x:Name="WindText"
                        Grid.Column="2"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center" />

				</Grid>


				<Grid ColumnDefinitions="120,*,65">

					<TextBlock
                        Text="Limit"
                        VerticalAlignment="Center" />

					<Slider
                        x:Name="ParticleLimitSlider"
                        Grid.Column="1"
                        Minimum="10"
                        Maximum="250"
                        ValueChanged="SliderChanged" />

					<TextBlock
                        x:Name="ParticleLimitText"
                        Grid.Column="2"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center" />

				</Grid>

			</StackPanel>

		</Border>


		<Border
            Classes="panel"
            Padding="14">

			<Grid RowDefinitions="Auto,*,Auto">

				<Grid
                    ColumnDefinitions="*,Auto"
                    Margin="0,0,0,10">

					<StackPanel>

						<TextBlock
                            Text="Custom Effects"
                            FontSize="17"
                            FontWeight="SemiBold" />

						<TextBlock
                            Text="Effects imported from .axfx packages."
                            FontSize="12"
                            Classes="muted" />

					</StackPanel>

					<Button
                        Grid.Column="1"
                        Content="Import"
                        Click="ImportEffect_Click" />

				</Grid>


				<ListBox
                    x:Name="CustomEffectList"
                    Grid.Row="1"
                    MinHeight="100" />


				<StackPanel
                    Grid.Row="2"
                    Margin="0,10,0,0"
                    Orientation="Horizontal"
                    Spacing="6">

					<Button
                        Content="Enable / Disable"
                        Click="ToggleCustomEffect_Click" />

					<Button
                        Content="Preview"
                        Click="PreviewCustomEffect_Click" />

					<Button
                        Content="Export"
                        Click="ExportCustomEffect_Click" />

					<Button
                        Content="Open Folder"
                        Click="OpenCustomEffectFolder_Click" />

					<Button
                        Content="Remove"
                        Click="RemoveCustomEffect_Click" />

				</StackPanel>

			</Grid>

		</Border>


		<StackPanel
            Orientation="Horizontal"
            HorizontalAlignment="Right"
            Spacing="8">

			<Button
                Content="Reset"
                Click="Reset_Click" />

			<Button
                Content="Preview"
                Click="Preview_Click" />

			<Button
                Content="Save"
                Classes="primary"
                Click="Save_Click" />

		</StackPanel>


		<TextBlock
            x:Name="StatusText"
            Classes="muted" />

	</StackPanel>

</UserControl>