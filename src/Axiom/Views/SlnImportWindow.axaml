<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Axiom.Views.SlnImportWindow"
    Title="Import Visual Studio Solution"
    Width="620"
    Height="440"
    MinWidth="520"
    MinHeight="360"
    WindowStartupLocation="CenterOwner">

    <Grid
        Margin="20"
        RowDefinitions="Auto,Auto,*,Auto">

        <TextBlock
            Text="Import Visual Studio Solution"
            FontSize="22"
            FontWeight="SemiBold" />

        <TextBlock
            Grid.Row="1"
            Margin="0,6,0,16"
            Text="Choose a project to convert to an Axiom project. The original Visual Studio files will not be removed."
            TextWrapping="Wrap"
            Classes="muted" />

        <ListBox
            x:Name="ProjectList"
            Grid.Row="2" />

        <Grid
            Grid.Row="3"
            Margin="0,16,0,0"
            ColumnDefinitions="*,Auto,Auto">

            <TextBlock
                x:Name="StatusText"
                VerticalAlignment="Center"
                Classes="muted" />

            <Button
                Grid.Column="1"
                Content="Cancel"
                Margin="0,0,6,0"
                Click="Cancel_Click" />

            <Button
                Grid.Column="2"
                Content="Import"
                Classes="primary"
                Click="Import_Click" />

        </Grid>

    </Grid>

</Window>